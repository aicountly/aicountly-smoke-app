# smoke.aicountly.org Playwright worker
# Copy to .env on the server; never commit a real .env.
#
# cPanel path: ${PROD_REMOTE_ROOT}/worker/
# Not a public website — long-running Node process under PM2
# (process name: aicountly-smoke-worker, see ecosystem.config.cjs).
# The deploy workflow restarts that process but never writes this file.

# Smoke portal API (CodeIgniter on smoke.aicountly.org).
WORKER_BACKEND_URL=https://smoke.aicountly.org/api/v1

# Shared secret — must match WORKER_SHARED_TOKEN in api/.env on the portal host.
WORKER_SHARED_TOKEN=

# Identifier sent to the API on every lease request and shown in the portal under
# Run detail → Sessions → "Worker". Keep it equal to the PM2 process name so a run
# can be traced back to this host; it is how you tell this worker apart from the
# retired shared worker on worker.apis.aicountly.com.
WORKER_ID=aicountly-smoke-worker

# Polling cadence.
WORKER_POLL_INTERVAL_MS=2500
WORKER_LEASE_SECONDS=600

# Hard visit ceiling; expected_screens is a planning estimate, not a runtime quota.
SMOKE_MAX_SCREENS_PER_SESSION=40

# Per-session cap for retained clean action screenshots. Marked model-input images
# are deleted after inference. Keep this at least as high as the action ceiling.
SMOKE_STEP_SCREENSHOT_RETENTION=120

# Resolve unexpected screens from the brain's recommendation instead of parking the
# job for an operator (default true). Set false to be asked about every one; a run
# then waits up to 30 minutes per decision and fails the session on timeout.
SMOKE_AUTONOMOUS=true

# Name used for records the run creates, and the contact on synthetic forms.
# SMOKE_COMPANY_NAME=Smoke Test Co
# SMOKE_COMPANY_EMAIL=smoke.test@example.com

# Evidence root. LEAVE UNSET on the cPanel deploy.
#
# The worker defaults to ${repoRoot}/smoke-reports, where repoRoot is
# cwd + SMOKE_ROOT_RELATIVE. PM2 runs with cwd = ${PROD_REMOTE_ROOT}/worker, so the
# default is ${PROD_REMOTE_ROOT}/smoke-reports — the same physical directory the API
# resolves from api/.env `REPORTS_DIR = ../smoke-reports` (relative to CodeIgniter
# ROOTPATH = ${PROD_REMOTE_ROOT}/api/).
#
# Both sides MUST land on one directory: the worker writes screenshots/HTML there and
# the API reads them back for the Reports page. Setting this to something else (an
# absolute /home/... path from another account, for example) is how the Reports page
# ends up with missing screenshots. Only set it if you deliberately move the
# directory, and change api/.env REPORTS_DIR to match in the same breath.
# REPORTS_DIR=

# Where the worker looks for repo-shared assets (samples/, smoke-reports/), relative
# to the process cwd. Default '..' is correct on cPanel: cwd ${PROD_REMOTE_ROOT}/worker
# → ${PROD_REMOTE_ROOT}. Only change it if the worker is not one level below the
# directory holding samples/.
# SMOKE_ROOT_RELATIVE=..

# Headless Chromium (true/false or 1/0).
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_USER_AGENT=AICountlySmokeBot/0.1 (+internal)

# Login "Jump To" product. Leave BOTH unset: the worker derives Jump To from each
# profile's product_name (hrms → HRMS, books → Smart Books, auditor → Auditor,
# fr → Financial Reporting, …).
#
# A global SMOKE_JUMP_TO=Smart Books used to drag every product onto Books; it is
# now only consulted after the product mapping and logs a warning when it conflicts.
# SMOKE_JUMP_TO=
#
# Per-product override for tenants whose dropdown label differs, e.g.:
# SMOKE_JUMP_TO_HRMS=HRMS
