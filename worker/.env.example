# smoke.aicountly.org Playwright worker
# Copy to .env on the server; never commit a real .env.
#
# cPanel path: ${PROD_REMOTE_ROOT}/worker/
# Not a public website — long-running Node process (use PM2).

# Smoke portal API (CodeIgniter on smoke.aicountly.org).
WORKER_BACKEND_URL=https://smoke.aicountly.org/api/v1

# Shared secret — must match WORKER_SHARED_TOKEN in api/.env on the portal host.
WORKER_SHARED_TOKEN=

# Host identifier sent to the API on each lease request.
WORKER_ID=smoke-worker

# Polling cadence.
WORKER_POLL_INTERVAL_MS=2500
WORKER_LEASE_SECONDS=600

# Hard visit ceiling; expected_screens is a planning estimate, not a runtime quota.
SMOKE_MAX_SCREENS_PER_SESSION=40

# Local evidence root (absolute on server, outside public_html if possible).
REPORTS_DIR=/home/YOUR_CPANEL_USER/smoke-reports

# Headless Chromium (true/false or 1/0).
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_USER_AGENT=AICountlySmokeBot/0.1 (+internal)

# Login "Jump To" product. Leave BOTH unset on a shared multi-product worker:
# the worker derives Jump To from each profile's product_name (hrms → HRMS,
# books → Smart Books, auditor → Auditor, fr → Financial Reporting, …).
#
# A global SMOKE_JUMP_TO=Smart Books used to drag every product onto Books; it is
# now only consulted after the product mapping and logs a warning when it conflicts.
# SMOKE_JUMP_TO=
#
# Per-product override for tenants whose dropdown label differs, e.g.:
# SMOKE_JUMP_TO_HRMS=HRMS
