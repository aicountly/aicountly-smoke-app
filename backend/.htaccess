# Deployed as api/.htaccess. api/ is the whole CodeIgniter project root
# (backend/); only public/ — the front controller — is meant for the web.
# Everything else here would otherwise be fetched directly or run as PHP:
# composer.json/.lock, spark, env, .env, app/, vendor/, writable/ (logs and old
# debug-toolbar traces) and tests/.
#
# This file turns the rewrite engine on, so the docroot's /api/v1 rules no
# longer apply below api/; the same routing is repeated here. ("Require all
# denied" would refuse /api/v1/* too: that URL maps into this directory, and
# access is checked before any rewrite runs.)
# HTTPS only: a plain-http request is redirected (308) to the same URL on https.
# It never loops behind a TLS-terminating proxy: a request that arrived over TLS, that the proxy
# marks as https (X-Forwarded-Proto / X-Forwarded-SSL) or that came in on port 443 is left alone.
# localhost and 127.0.0.1 stay on http for local development.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP_HOST} .
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L,NE]
</IfModule>

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Pass Authorization through to PHP (stripped by default on CGI/FastCGI).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # The API: /api/v1/* goes to the front controller, as in the docroot.
    RewriteRule ^v1/(.*)$ public/index.php/api/v1/$1 [L,QSA,NC]
    RewriteRule ^v1/?$ public/index.php/api/v1 [L,QSA,NC]

    # Everything else in the project root is refused. public/ has its own
    # .htaccess, so these rules do not reach requests inside it.
    RewriteRule ^ - [F,L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
