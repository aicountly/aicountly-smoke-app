Options -Indexes

# The parent api/.htaccess refuses the whole project root; public/ (the front
# controller) is the one directory the web may reach.
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization through to PHP (stripped by default on CGI/FastCGI).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
