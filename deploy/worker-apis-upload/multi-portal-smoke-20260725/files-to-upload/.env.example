# AICOUNTLY shared Playwright worker — worker.apis.aicountly.com
# Copy to .env on the server; never commit a real .env.
#
# cPanel path: /home/apisaicountly/public_html/worker.apis.aicountly.com
# One install for all portals. Enable QA and/or Smoke via the blocks below.

# Host identifier sent on lease/ping requests.
QA_WORKER_ID=worker.apis.aicountly.com

# -----------------------------------------------------------------------------
# QA portal (qa.aicountly.org) — optional if only Smoke is enabled
# -----------------------------------------------------------------------------
QA_API_URL=https://qa.aicountly.org/api
# Must match QA_WORKER_TOKEN in qa.aicountly.org server-php/.env
QA_WORKER_TOKEN=

QA_POLL_INTERVAL_MS=5000
QA_HEARTBEAT_MS=15000

# Local scratch before upload to QA API (outside public_html).
QA_REPORTS_DIR=/home/apisaicountly/qa-reports

QA_HEADLESS=1
QA_SLOWMO_MS=0

# -----------------------------------------------------------------------------
# Smoke portal (smoke.aicountly.org) — optional if only QA is enabled
# -----------------------------------------------------------------------------
# Base must include /api/v1 (Smoke mounts worker routes there).
SMOKE_API_URL=https://smoke.aicountly.org/api/v1
# Must match WORKER_SHARED_TOKEN in smoke.aicountly.org api/.env
SMOKE_WORKER_TOKEN=

SMOKE_LEASE_SECONDS=600
SMOKE_POLL_INTERVAL_MS=5000

# Optional Smoke Playwright overrides (default: same as QA_HEADLESS / QA_SLOWMO_MS).
# SMOKE_HEADLESS=1
# SMOKE_SLOWMO_MS=0
# SMOKE_BROWSER=chromium
