# HTTPS only: a plain-http request is redirected (301) to the same URL on https.
# It never loops behind a TLS-terminating proxy: a request that arrived over TLS, that the proxy
# marks as https (X-Forwarded-Proto / X-Forwarded-SSL) or that came in on port 443 is left alone.
# localhost and 127.0.0.1 stay on http for local development.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP:X-Forwarded-SSL} !=on
    RewriteCond %{SERVER_PORT} !=443
    RewriteCond %{HTTP_HOST} .
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
</IfModule>

Options -Indexes

# Server-side trees the deploy keeps under the docroot, not for the web: the
# Node worker (code, scripts, .env), test samples, SQL migrations and
# smoke-reports/ (screenshots and HTML reports; signed-in users get those
# through the API's RBAC-checked routes, never as plain files).
RedirectMatch 403 ^/(worker|samples|migrations|smoke-reports)(/|$)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization through to PHP (stripped by default on CGI/FastCGI).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # CodeIgniter API — backend deployed to api/ (public/ is the front controller)
    RewriteRule ^api/v1/(.*)$ api/public/index.php/api/v1/$1 [L,QSA,NC]
    RewriteRule ^api/v1/?$ api/public/index.php/api/v1 [L,QSA,NC]

    # React SPA — all other routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^ index.html [L]
</IfModule>

# --- Security headers (security audit, October 2026) ---------------------------
# Internal tool: never framed by another site, no MIME sniffing, HTTPS only.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>
